# ── 环境变量模板 ──────────────────────────────────────
# 复制此文件为 .env 并修改

# GitHub Personal Access Token（提高 API 限额到 5000/h）
# 不带 Token 时限额为 60/h，建议设置
GITHUB_TOKEN=

# 定时调度器开关（true/false）
SCHEDULER_ENABLED=true

# API 服务地址和端口
API_HOST=0.0.0.0
API_PORT=8000

# CORS 允许的来源（逗号分隔）
# 生产环境设置为你的域名，例如：https://aiknowledge.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── LLM：火山方舟 / 豆包（doubao-seed-1.6-flash）────────
# 总开关；true 但缺 key 或模型标识时会自动降级为规则路径
LLM_ENABLED=true

# API Key（控制台创建，务必不要提交到仓库）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型标识：优先填接入点 ID（ep-xxxx），留空则用模型名直调
ARK_ENDPOINT_ID=
ARK_MODEL=doubao-seed-1-6-flash-250828

# 推理模式：本场景必须 disabled，否则首字延迟与 token 费用都会明显上升
ARK_THINKING=disabled
ARK_TEMPERATURE=0.3

# 超时与重试（秒 / 次）
ARK_TIMEOUT_CONNECT=3
ARK_TIMEOUT_READ=20
ARK_MAX_RETRIES=1

# 预算护栏：每日调用次数与 token 上限，0 表示不限制
ARK_DAILY_CALL_LIMIT=300
ARK_DAILY_TOKEN_LIMIT=1000000

# 仅离线评测时设为 true（把全量仓库塞进上下文，生产成本不可接受）
ARK_ALLOW_FULL_CATALOG=false
