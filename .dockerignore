# ── 项目根目录 .dockerignore ─────────────────────
# 用于 backend 构建上下文 (context: .)

# Dependencies
frontend/node_modules/
frontend/.nuxt/
frontend/.output/

# Python cache
backend/__pycache__/
backend/**/__pycache__/
*.pyc
*.pyo

# SQLite data (use volume instead)
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm

# Git
.git/
.gitignore

# Environment
.env
.env.example

# IDE
.vscode/
.idea/

# TRAE workspace
.screenshots/
.superpowers/
.trae-html-share-packages/
.uploads/

# Docs (not needed in image)
docs/
*.md
LICENSE

# System
.DS_Store
Thumbs.db
